+// re4-port: GXSetDrawSync/GXReadDrawSync/GXSetDrawSyncCallback -- see dolphin/gx/GXManage.h and
+// aurora::gx::fifo::set_last_token's comment for how "reached" is defined under Drain mode.
+// Unlike GXSetDrawDone (which flushes the FIFO immediately, GXDrawDone actually drains it),
+// GXSetDrawSync only queues the BP writes -- real hardware's GXSetDrawSync does not block either;
+// the token is only actually reached once the FIFO drains up to this point (the next GXDrawDone,
+// frame swap, or explicit drain), exactly mirroring GXSetDrawDone/GXDrawDone's own split.
+void GXSetDrawSync(u16 token) {
+  GXFlush();
+  GX_WRITE_RAS_REG(BP_TOKEN(token, GX_BP_REG_PETOKENINT));
+  GX_WRITE_RAS_REG(BP_TOKEN(token, GX_BP_REG_PETOKEN));
+  aurora::gx::fifo::publish();
+}
+
+u16 GXReadDrawSync() { return aurora::gx::fifo::get_last_token(); }
+
+GXDrawSyncCallback GXSetDrawSyncCallback(GXDrawSyncCallback cb) { return aurora::gx::fifo::set_draw_sync_callback(cb); }
+
+// re4-port: see dolphin/gx/GXManage.h's declaration comment -- every src/game call site passes 0
+// (trans.cpp), and this port's SU-texture-region logic (__GXSetSUTexRegs/__GXUpdateBPMask, both
+// below) does not model per-stage indirect masking, so there is no rendering decision for this
+// value to change yet; recorded for introspection/future use only.
+static u32 sIndirectMask = 0;
+void __GXSetIndirectMask(u32 mask) { sIndirectMask = mask; }
