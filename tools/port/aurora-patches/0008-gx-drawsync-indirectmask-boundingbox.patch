diff -ruN aurora_a/lib/gx/fifo.hpp aurora_b/lib/gx/fifo.hpp
--- a/lib/gx/fifo.hpp	2026-09-25 08:10:49
+++ b/lib/gx/fifo.hpp	2026-09-25 07:42:26
@@ -99,6 +99,17 @@
 using DrawDoneCallback = void (*)();
 DrawDoneCallback set_draw_done_callback(DrawDoneCallback callback) noexcept;
 
+// re4-port: token-valued analog of the draw-done callback above, for GXSetDrawSync/
+// GXReadDrawSync/GXSetDrawSyncCallback (dolphin/gx/GXManage.h). set_last_token() is called by
+// command_processor.cpp's BP handler the moment it processes the token BP write -- under this
+// port's synchronous Drain processing mode that happens inside drain()/process_to(), i.e. on the
+// game thread, at the point in the command stream the token was queued at, never on a worker
+// thread (there isn't one in Drain mode).
+using DrawSyncCallback = void (*)(uint16_t token);
+DrawSyncCallback set_draw_sync_callback(DrawSyncCallback callback) noexcept;
+void set_last_token(uint16_t token) noexcept;
+uint16_t get_last_token() noexcept;
+
