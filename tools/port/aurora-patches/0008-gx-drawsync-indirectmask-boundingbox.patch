+// for GXGetIndirectMask()-style introspection (none exists yet) rather than changing any
+// rendering decision. TO VERIFY if a future non-zero caller needs the real masking behavior.
+void __GXSetIndirectMask(u32 mask);
 void GXFlush(void);
 void GXPixModeSync(void);
 void GXTexModeSync(void);
 void GXSetMisc(GXMiscToken token, u32 val);
 void GXAbortFrame(void);
+// re4-port: resets real hardware's per-primitive screen-space bounding-box accumulator (read back
