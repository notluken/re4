 CommandDataNod* s_disc;
 
+// re4-port: DVDFileInfo::cb.userData is documented (and used by real GameCube games,
+// including this one -- src/game/dvd.cpp's cDvdQueue::fileReadAsync) as free for the caller
+// once DVDOpen()/DVDFastOpen() has returned; the real hardware's DVD low-level driver never
+// looks at it again. This reimplementation used to stash its own per-file handle object in
+// that same field, which the game unconditionally overwrites with its own bookkeeping
+// pointer right after open -- corrupting Aurora's handle and crashing the DVD worker thread
+// on the next read. Keep Aurora's handle in a side table keyed by the (stable, per-open)
+// DVDCommandBlock* instead, so the game is free to use cb.userData as real hardware allows.
+std::mutex s_handleMapMutex;
+std::unordered_map<DVDCommandBlock*, CommandDataBase*> s_handleMap;
+
+void setHandleFor(DVDCommandBlock* block, CommandDataBase* handle) {
+  std::lock_guard lock(s_handleMapMutex);
+  s_handleMap[block] = handle;
+}
+
+CommandDataBase* takeHandleFor(DVDCommandBlock* block) {
+  std::lock_guard lock(s_handleMapMutex);
+  auto it = s_handleMap.find(block);
+  if (it == s_handleMap.end()) {
+    return nullptr;
+  }
+  CommandDataBase* handle = it->second;
+  s_handleMap.erase(it);
+  return handle;
+}
+
+CommandDataBase* lookupHandleFor(DVDCommandBlock* block) {
+  std::lock_guard lock(s_handleMapMutex);
+  auto it = s_handleMap.find(block);
+  return it == s_handleMap.end() ? nullptr : it->second;
+}
